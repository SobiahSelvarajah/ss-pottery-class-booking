
generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}


model Booking {
  id          String          @id @default(uuid())
  name        String
  email       String
  date        DateTime
  guests      Int
  message     String?
  status      BookingStatus   @default(PENDING)
  createdAt   DateTime        @default(now())    
} 


model Contact {
  id          String      @id @default(uuid())
  name        String
  email       String
  subject     String?
  message     String
  createdAt   DateTime     @default(now())      
}
